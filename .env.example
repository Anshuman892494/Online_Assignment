# Application Configuration
APP_NAME="Document Intelligence & Question Extraction Service"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Security & JWT Auth
SECRET_KEY="replace_with_a_secure_random_jwt_secret_key_minimum_32_characters_long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/doc_intelligence"
DATABASE_URL_SYNC="postgresql+psycopg://postgres:postgres@localhost:5432/doc_intelligence"

# SQLite Zero-Config Fallback (Automatically used if PostgreSQL is unreachable during local testing)
SQLITE_FALLBACK_URL="sqlite+aiosqlite:///./storage/dev_database.db"

# Redis Queue & Distributed State
REDIS_URL="redis://localhost:6379/0"

# AI / Vision Extraction (Google Gemini Multimodal API)
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# File Storage & Limits
MAX_UPLOAD_SIZE_MB=25
UPLOAD_DIR="./storage/uploads"
EXTRACTED_DIR="./storage/extracted"
ALLOWED_EXTENSIONS=["pdf", "png", "jpg", "jpeg"]
